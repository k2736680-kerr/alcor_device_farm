DEVICE_FARM_SERVER_ADDRESS=127.0.0.1:8080
DEVICE_FARM_SERVER_READ_TIMEOUT=10s
DEVICE_FARM_SERVER_WRITE_TIMEOUT=30s
DEVICE_FARM_SERVER_IDLE_TIMEOUT=60s
DEVICE_FARM_SERVER_SHUTDOWN_TIMEOUT=10s
DEVICE_FARM_DATABASE_URL=
DEVICE_FARM_LOG_LEVEL=info
DEVICE_FARM_LOG_FORMAT=json
DEVICE_FARM_LEASE_SCHEDULER_INTERVAL=250ms
DEVICE_FARM_LEASE_REAPER_INTERVAL=1s
DEVICE_FARM_LEASE_GRACE_PERIOD=30s
DEVICE_FARM_RECONCILE_INTERVAL=2s
DEVICE_FARM_RECONCILE_HOST_TIMEOUT=30s
DEVICE_FARM_RECONCILE_STF_VISIBILITY_GRACE=30s
DEVICE_FARM_RECONCILE_HOST_RECOVERY_GRACE=90s
DEVICE_FARM_RECONCILE_FAILURE_THRESHOLD=3
DEVICE_FARM_WARM_POOL_INTERVAL=30s

# STF 3.7.9 API. The token must come from the deployment secret store and is
# never returned by Device Farm APIs.
DEVICE_FARM_STF_ENABLED=false
DEVICE_FARM_STF_BASE_URL=http://127.0.0.1:7100
DEVICE_FARM_STF_API_TOKEN=
DEVICE_FARM_STF_TIMEOUT=5s
DEVICE_FARM_STF_ATTEMPTS=3
DEVICE_FARM_STF_RETRY_DELAY=200ms

DEVICE_FARM_CONSOLE_ENABLED=false
DEVICE_FARM_CONSOLE_USERS_FILE=
DEVICE_FARM_CONSOLE_DEVELOPMENT_INSECURE=false
DEVICE_FARM_CONSOLE_SESSION_MAX_AGE=8h
DEVICE_FARM_CONSOLE_SESSION_IDLE_TIMEOUT=30m
DEVICE_FARM_CONSOLE_CLEANUP_INTERVAL=10m
DEVICE_FARM_CONSOLE_LOGIN_WINDOW=15m
DEVICE_FARM_CONSOLE_LOGIN_MAX_FAILURES=5

# Inject real values through the deployment secret mechanism. Keep this file
# empty so it can be committed safely.
DEVICE_FARM_SECURITY_SERVICE_TOKEN=
DEVICE_FARM_SECURITY_SERVICE_PREVIOUS_TOKEN=
DEVICE_FARM_SECURITY_AGENT_TOKEN=
DEVICE_FARM_SECURITY_AGENT_PREVIOUS_TOKEN=

# Host Agent process settings. The host ID must already exist in Device Farm.
DEVICE_FARM_AGENT_SERVER_URL=http://127.0.0.1:8080
DEVICE_FARM_AGENT_HOST_ID=
DEVICE_FARM_AGENT_PROVIDER=mock
DEVICE_FARM_AGENT_CONCURRENCY=1
DEVICE_FARM_AGENT_LEASE_SECONDS=300
DEVICE_FARM_AGENT_COMMAND_TIMEOUT=270s
DEVICE_FARM_IMAGE_PREPARE_TIMEOUT=2h
DEVICE_FARM_IMAGE_PREPARE_SCRIPT=
DEVICE_FARM_SDKMANAGER_BINARY=/opt/android-sdk/cmdline-tools/19.0/bin/sdkmanager
DEVICE_FARM_SDKMANAGER_VERSION=19.0
DEVICE_FARM_ANDROID_PUBLISH_REPOSITORY=registry.internal/alcor/android-emulator
DEVICE_FARM_AGENT_STF_ADB_SERVER=
DEVICE_FARM_ADB_BINARY=adb

# Docker Provider is only supported on a Linux host with readable/writable
# /dev/kvm. Use a fixed tag or digest; floating latest is rejected.
DEVICE_FARM_DOCKER_BINARY=docker
DEVICE_FARM_DOCKER_IMAGE=
DEVICE_FARM_DOCKER_ADVERTISE_HOST=
DEVICE_FARM_DOCKER_BIND_ADDRESS=127.0.0.1
DEVICE_FARM_DOCKER_KVM_DEVICE=/dev/kvm
DEVICE_FARM_DOCKER_ADB_PORT=5555
DEVICE_FARM_DOCKER_ADB_SERIAL=emulator-5554
DEVICE_FARM_DOCKER_DATA_MOUNT_PATH=/home/androidusr
DEVICE_FARM_DOCKER_EMULATOR_DEVICE="Pixel 9"
# Compatibility fallback for images that do not carry a runtime_profile.
# Normal devices use the CPU and memory stored in their image runtime_profile.
DEVICE_FARM_DOCKER_CPUS=4
DEVICE_FARM_DOCKER_MEMORY=5g
DEVICE_FARM_DOCKER_PIDS_LIMIT=512
DEVICE_FARM_AGENT_DEVICE_SLOT_LIMIT=0
DEVICE_FARM_DOCKER_DATA_ROOT=/var/lib/docker
DEVICE_FARM_DOCKER_RENDER_DEVICE=/dev/dri/renderD128
