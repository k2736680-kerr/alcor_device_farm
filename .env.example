DEVICE_FARM_SERVER_ADDRESS=127.0.0.1:8080
DEVICE_FARM_SERVER_READ_TIMEOUT=10s
DEVICE_FARM_SERVER_WRITE_TIMEOUT=30s
DEVICE_FARM_SERVER_IDLE_TIMEOUT=60s
DEVICE_FARM_SERVER_SHUTDOWN_TIMEOUT=10s
DEVICE_FARM_DATABASE_URL=
DEVICE_FARM_LOG_LEVEL=info
DEVICE_FARM_LOG_FORMAT=json
DEVICE_FARM_LEASE_SCHEDULER_INTERVAL=250ms
DEVICE_FARM_LEASE_REAPER_INTERVAL=1s
DEVICE_FARM_LEASE_GRACE_PERIOD=30s
DEVICE_FARM_RECONCILE_INTERVAL=2s
DEVICE_FARM_RECONCILE_HOST_TIMEOUT=30s
DEVICE_FARM_RECONCILE_FAILURE_THRESHOLD=3

# Inject real values through the deployment secret mechanism. Keep this file
# empty so it can be committed safely.
DEVICE_FARM_SECURITY_SERVICE_TOKEN=
DEVICE_FARM_SECURITY_AGENT_TOKEN=

# Host Agent process settings. The host ID must already exist in Device Farm.
DEVICE_FARM_AGENT_SERVER_URL=http://127.0.0.1:8080
DEVICE_FARM_AGENT_HOST_ID=
