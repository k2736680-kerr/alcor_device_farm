# Copy to a permission-restricted file on the dedicated macOS Host.
# Never commit a real Host ID, service token, UDID, Apple account, signing key, or password.

DEVICE_FARM_AGENT_SERVER_URL=https://device-farm.internal.example
DEVICE_FARM_AGENT_HOST_ID=replace-with-registered-host-id
DEVICE_FARM_SECURITY_AGENT_TOKEN=load-from-the-host-secret-store
DEVICE_FARM_AGENT_PROVIDER=appium_device_farm_ios

IOS_HOST_ROOT=/absolute/path/alcor-device-farm/df041
APPIUM_HOME=/absolute/path/alcor-device-farm/df041/appium-home
DEVICE_FARM_IOS_APPIUM_ENDPOINT=http://127.0.0.1:4723
DEVICE_FARM_IOS_ALLOW_UDIDS=replace-with-fixed-allowlisted-udid
# Fence 可以监听 loopback；跨主机提供时必须由受控 HTTPS 反向代理暴露。
DEVICE_FARM_IOS_SESSION_FENCE_LISTEN=127.0.0.1:4810
DEVICE_FARM_IOS_SESSION_FENCE_ADVERTISE_URL=https://ios-host.internal.example/session-fence

DEVICE_FARM_NODE_BINARY=/absolute/path/alcor-device-farm/df041/node/bin/node
DEVICE_FARM_APPIUM_BINARY=/absolute/path/alcor-device-farm/df041/runtime/node_modules/.bin/appium
DEVICE_FARM_GO_IOS_BINARY=/absolute/path/alcor-device-farm/df041/runtime/node_modules/go-ios/dist/go-ios-darwin-arm64_darwin_arm64/ios
DEVICE_FARM_IOS_WDA_PACKAGE_JSON=/absolute/path/alcor-device-farm/df041/appium-home/node_modules/appium-xcuitest-driver/node_modules/appium-webdriveragent/package.json

DEVICE_FARM_AGENT_CONCURRENCY=1
DEVICE_FARM_AGENT_DEVICE_SLOT_LIMIT=1
DEVICE_FARM_AGENT_LEASE_SECONDS=300
DEVICE_FARM_AGENT_COMMAND_TIMEOUT=270s
DEVICE_FARM_APPIUM_HEALTH_TIMEOUT=5s
