# Copy to .env on the Linux STF host. Never commit the real file.
STF_IMAGE=devicefarmer/stf:3.7.9
RETHINKDB_IMAGE=rethinkdb:2.4.2

# Internal address or DNS name reachable by authorized browsers/workers.
STF_PUBLIC_IP=10.0.0.20

# Keep 127.0.0.1 when a same-host reverse proxy provides TLS and access
# control. Use a private interface address only when direct intranet access is
# intentionally allowed. Never expose STF directly to the public Internet.
STF_BIND_ADDRESS=127.0.0.1

STF_ADMIN_NAME=Device Farm Admin
STF_ADMIN_EMAIL=device-farm-admin@example.invalid

# Generate at least 32 random bytes. Do not reuse Device Farm service or Agent
# tokens. The value is used by STF processes and is never sent to browsers as
# a Device Farm management token.
STF_AUTH_SECRET=replace-with-a-long-random-secret
TZ=Asia/Shanghai
