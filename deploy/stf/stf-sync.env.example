# 复制为 /etc/alcor-device-farm/stf-sync.env（权限 0600，属主 root）。
#
# 本文件由 alcor-device-farm-stf-sync.service 通过 EnvironmentFile 读取，
# 用于把远程宿主机的 Android 设备汇入本机 STF 的 ADB server（ADR-0037 决策 2）。
#
# 注意：Service Token 只写在这里或下面的 token 文件里，不要写进仓库。

# 控制面地址：取设备清单的来源。
DEVICE_FARM_API_BASE_URL=http://10.0.80.220:18182

# Service Token 文件（推荐）。未设置 DEVICE_FARM_SERVICE_TOKEN 时从这里读取。
DEVICE_FARM_API_TOKEN_FILE=/etc/alcor-device-farm/service-token

# 若不便使用 token 文件，可改为直接写：
# DEVICE_FARM_SERVICE_TOKEN=replace-with-the-control-plane-service-token

# STF compose 文件与 `.env` 的实际位置。
#
# 脚本默认按「脚本所在目录的上级/deploy/stf」推导，这只在仓库检出布局下成立。
# 安装器会把脚本复制到 /opt/alcor-device-farm/scripts/，那里没有 deploy/stf/，
# 默认推导因此失效 —— 安装器生成本文件时会自动在这两行填入仓库副本的真实位置。
# 手工创建本文件时，必须自行确认这两个路径。
# STF_COMPOSE_FILE=/path/to/repo/deploy/stf/compose.yaml
# STF_ENV_FILE=/path/to/repo/deploy/stf/.env

# 本机地址列表（逗号分隔）。本机设备由本机 Host Agent 自行注册，需要跳过避免重复 connect。
# 留空时脚本会用 `hostname -I` 自动探测。
# STF_LOCAL_HOSTS=10.0.30.171

# 设备列表分页大小。服务端上限 200，脚本会自动翻页取全，通常无需修改。
# PAGE_SIZE=200

# 单次 adb connect 超时秒数。
# CONNECT_TIMEOUT=15
