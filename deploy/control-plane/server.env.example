# Pre-deployment control-plane configuration for 10.0.80.220.
# Copy to server.env with mode 0600. Never commit the populated file.
DEVICE_FARM_VERSION=predeploy
DEVICE_FARM_COMMIT=unknown
DEVICE_FARM_BUILD_DATE=unknown
DEVICE_FARM_BIND_ADDRESS=10.0.80.220
DEVICE_FARM_HTTP_PORT=18180
DEVICE_FARM_IOS_GATEWAY_PORT=18181
DEVICE_FARM_GATEWAY_IMAGE=nginx:1.29.1-alpine
DEVICE_FARM_GATEWAY_MEMORY_LIMIT=64m
DEVICE_FARM_GATEWAY_CPUS=0.25

DEVICE_FARM_SERVER_ADDRESS=0.0.0.0:8080
DEVICE_FARM_DATABASE_URL=postgresql://device_farm_server:CHANGE_ME@postgres:5432/device_farm
DEVICE_FARM_SECURITY_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN
DEVICE_FARM_SECURITY_SERVICE_PREVIOUS_TOKEN=
DEVICE_FARM_SECURITY_AGENT_TOKEN=CHANGE_ME_AGENT_TOKEN
DEVICE_FARM_SECURITY_AGENT_PREVIOUS_TOKEN=
DEVICE_FARM_LOG_LEVEL=info
DEVICE_FARM_LOG_FORMAT=json

# Pre-deployment keeps the current STF on 10.0.30.171 unchanged.
DEVICE_FARM_STF_ENABLED=false
DEVICE_FARM_STF_BASE_URL=http://10.0.30.171:7100
DEVICE_FARM_STF_API_TOKEN=
DEVICE_FARM_STF_TIMEOUT=5s
DEVICE_FARM_STF_ATTEMPTS=3
DEVICE_FARM_STF_RETRY_DELAY=200ms

DEVICE_FARM_CONSOLE_ENABLED=true
DEVICE_FARM_CONSOLE_USERS_FILE=/run/secrets/device-farm/console-users.yaml
DEVICE_FARM_CONSOLE_DEVELOPMENT_INSECURE=false
DEVICE_FARM_CONSOLE_SESSION_MAX_AGE=720h
DEVICE_FARM_CONSOLE_SESSION_IDLE_TIMEOUT=720h
DEVICE_FARM_CONSOLE_CLEANUP_INTERVAL=10m
DEVICE_FARM_CONSOLE_LOGIN_WINDOW=15m
DEVICE_FARM_CONSOLE_LOGIN_MAX_FAILURES=5
