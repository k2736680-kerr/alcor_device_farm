+def install_uiautomator2_server_packages(serial: str) -> None:
+    apk_root = "/root/.appium/node_modules/appium-uiautomator2-driver/node_modules/appium-uiautomator2-server/apks"
+    server_apks = sorted(glob.glob(f"{apk_root}/appium-uiautomator2-server-v*.apk"))
+    test_apk = f"{apk_root}/appium-uiautomator2-server-debug-androidTest.apk"
+    apks = server_apks + [test_apk]
+    if len(server_apks) != 1 or not all(os.path.isfile(apk) for apk in apks):
+        raise RuntimeError("UiAutomator2 server APKs do not match the fixed driver")
+
+    for apk in apks:
+        last_error = "installation failed"
+        for attempt in range(1, 4):
+            result = subprocess.run(
+                ["adb", "-s", serial, "install", "-r", "--no-incremental", apk],
+                capture_output=True, text=True, timeout=10 * 60, check=False,
+            )
+            if result.returncode == 0 and "success" in result.stdout.lower():
+                logger.info("Installed UiAutomator2 package %s", os.path.basename(apk))
+                break
+            last_error = " ".join(value.strip() for value in (result.stdout, result.stderr) if value.strip())
+            logger.warning("UiAutomator2 package install attempt %s failed: %s", attempt, last_error)
+            time.sleep(15)
+        else:
+            raise RuntimeError(f"Cannot install {os.path.basename(apk)}: {last_error}")
+
+    for package_name in ("io.appium.uiautomator2.server", "io.appium.uiautomator2.server.test"):
+        result = subprocess.run(
+            ["adb", "-s", serial, "shell", "pm", "path", package_name],
+            capture_output=True, text=True, timeout=60, check=False,
+        )
+        if result.returncode != 0 or "package:" not in result.stdout:
+            raise RuntimeError(f"UiAutomator2 package is not registered: {package_name}")
+
+
