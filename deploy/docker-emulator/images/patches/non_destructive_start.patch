+    def _ensure_avd_reference(self) -> None:
+        avd_home = os.getenv("ANDROID_AVD_HOME", os.path.join(os.path.expanduser("~"), ".android", "avd"))
+        os.makedirs(avd_home, exist_ok=True)
+        reference_path = os.path.join(avd_home, f"{self.name}.ini")
+        with open(reference_path, 'w') as reference:
+            reference.write("avd.ini.encoding=UTF-8\n")
+            reference.write(f"path={self.path_emulator}\n")
+            reference.write(f"target=android-{self.api_level}\n")
+
+    def _remove_stale_avd_locks(self) -> None:
+        expected_name = f"@{self.name}".encode()
+        for process_id in os.listdir("/proc"):
+            if not process_id.isdigit():
+                continue
+            try:
+                with open(os.path.join("/proc", process_id, "cmdline"), "rb") as command_file:
+                    command = command_file.read()
+            except (FileNotFoundError, PermissionError, ProcessLookupError):
+                continue
+            if b"qemu-system" in command and expected_name in command:
+                raise RuntimeError(f"emulator '{self.name}' is already running")
+
+        removed = 0
+        for root, _, files in os.walk(self.path_emulator):
+            for file_name in files:
+                if not file_name.endswith(".lock"):
+                    continue
+                os.remove(os.path.join(root, file_name))
+                removed += 1
+        if removed:
+            self.logger.info(f"Removed {removed} stale AVD lock file(s)")
+
