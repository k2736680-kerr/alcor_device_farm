 def start_appium() -> None:
     if convert_str_to_bool(os.getenv(ENV.APPIUM)):
+        wait_for_emulator_appium_prerequisites()
         cmd = f"/usr/local/bin/appium"
         app_appium = Application("Appium", cmd,
                                  os.getenv(ENV.APPIUM_ADDITIONAL_ARGS, ""), False)
@@ -68,6 +70,59 @@ def start_appium() -> None:
         logger.info("env APPIUM cannot be found, Appium is not started!")
 
 
+def wait_for_emulator_appium_prerequisites() -> None:
+    if os.getenv(ENV.DEVICE_TYPE, "").lower() != DeviceType.EMULATOR.value.lower():
+        return
+
+    serial = os.getenv("ANDROID_SERIAL", "emulator-5554")
+    deadline = time.monotonic() + 12 * 60
+    last_error = "Android services are not ready"
+    while time.monotonic() < deadline:
+        try:
+            boot = subprocess.run(
+                ["adb", "-s", serial, "shell", "getprop", "sys.boot_completed"],
+                capture_output=True, text=True, timeout=30, check=False,
+            )
+            package_service = subprocess.run(
+                ["adb", "-s", serial, "shell", "service", "check", "package"],
+                capture_output=True, text=True, timeout=30, check=False,
+            )
+            settings_service = subprocess.run(
+                ["adb", "-s", serial, "shell", "settings", "get", "global", "device_provisioned"],
+                capture_output=True, text=True, timeout=30, check=False,
+            )
+            package_manager = subprocess.run(
+                ["adb", "-s", serial, "shell", "pm", "path", "android"],
+                capture_output=True, text=True, timeout=30, check=False,
+            )
+            if (
+                boot.stdout.strip() == "1"
+                and "found" in package_service.stdout.lower()
+                and settings_service.returncode == 0
+                and package_manager.returncode == 0
+                and "package:" in package_manager.stdout
+            ):
+                logger.info("Android package and settings services are ready")
+                time.sleep(30)
+                return
+            errors = " ".join(
+                value.strip()
+                for value in (
+                    package_service.stderr,
+                    settings_service.stderr,
+                    package_manager.stderr,
+                )
+                if value.strip()
+            )
+            if errors:
+                last_error = errors
+        except (OSError, subprocess.SubprocessError) as error:
+            last_error = str(error)
+        time.sleep(5)
+
+    raise RuntimeError(f"Android services did not become Appium-ready: {last_error}")
+
+
 def start_device() -> None:
     given_pt = get_env_value_or_raise(ENV.DEVICE_TYPE)
     selected_device = get_device(given_pt)
