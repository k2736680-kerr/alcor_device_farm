# Copy to server.env with mode 0600. Inject real secrets from the deployment
# secret mechanism; never commit the populated file.
DEVICE_FARM_VERSION=
DEVICE_FARM_COMMIT=
DEVICE_FARM_BUILD_DATE=
DEVICE_FARM_BIND_ADDRESS=127.0.0.1

DEVICE_FARM_SERVER_ADDRESS=127.0.0.1:8080
DEVICE_FARM_DATABASE_URL=
DEVICE_FARM_SECURITY_SERVICE_TOKEN=
DEVICE_FARM_SECURITY_SERVICE_PREVIOUS_TOKEN=
DEVICE_FARM_SECURITY_AGENT_TOKEN=
DEVICE_FARM_SECURITY_AGENT_PREVIOUS_TOKEN=
DEVICE_FARM_LOG_LEVEL=info
DEVICE_FARM_LOG_FORMAT=json

DEVICE_FARM_STF_ENABLED=false
DEVICE_FARM_STF_BASE_URL=http://127.0.0.1:7100
DEVICE_FARM_STF_API_TOKEN=

# 管理员 STF 原生 Web 远控。四项必须同时设置；AUTH_SECRET 必须与
# deploy/stf/.env 的 STF_AUTH_SECRET 一致，USER 身份必须与 API Token
# 所属 STF 用户一致。Secret 只保存在 mode 0600 的 server.env/Secret 管理器。
DEVICE_FARM_STF_WEB_URL=https://stf.example.internal
DEVICE_FARM_STF_WEB_AUTH_SECRET=
DEVICE_FARM_STF_WEB_USER_NAME=Device Farm Admin
DEVICE_FARM_STF_WEB_USER_EMAIL=
DEVICE_FARM_STF_WEB_TOKEN_TTL=30s

# Console (Web 控制台)。生产启用时 users_file 必须存在且仅 Server
# 运行身份可读；DEVELOPMENT_INSECURE 保持 false（仅限回环开发环境）。
DEVICE_FARM_CONSOLE_ENABLED=false
DEVICE_FARM_CONSOLE_USERS_FILE=
DEVICE_FARM_CONSOLE_DEVELOPMENT_INSECURE=false
DEVICE_FARM_CONSOLE_REMOTE_LEASE=60s
DEVICE_FARM_CONSOLE_REMOTE_HEARTBEAT=15s
